{
  "manifest_version": 3,
  "name": "Chevron Start Page",
  "version": "1.1.0",
  "description": "Chevron: keyboard-driven start page with macros, search suggestions and calculator.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://www.google.com/complete/search*",
    "https://api.openai.com/*",
    "https://open.er-api.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
